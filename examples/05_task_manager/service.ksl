# 任务管理器的 Actor 服务入口.
#
# 服务端 Handler 持有任务列表, 客户端通过消息请求并在自己的信箱收取回复.
# 每次变更后写回 `tasks.txt`; 输入 `quit` 或管道结束时退出.

@Use[{
  ^Task,
  ^Reply,
  ^Request,
  ^Command,
  formatList,
  addTask,
  completeTask,
  removeTask,
  statsText,
  formatError,
  parseRequest
}, "lib/model"];
@Use[{load, save}, "lib/store"];

@Let[client, @Handler[
  [self : Pid[Reply, string], service : Pid[Command, i64], request : Request] : string,
  @Block[
    @Let[sent, @Send[service, 0u, Command/Call[request, self]]],
    @Match[@Receive[0u, Option/Some[1000U]], {
      (/Some[reply], @Match[reply, { (Reply/Text[text], text) }]),
      (/None[], "timeout")
    }]
  ]]];

@Def[ask, [service : Pid[Command, i64], request : Request] : string,
  @Block[
    @Let[worker, @Spawn[1u, client, service, request]],
    @Match[@Join[worker], { (/Ok[text], text), (/Err[_], "client failed") }]
  ]];

@Def[handle, [request : Request, tasks : List[Task], path : string] : Pair[List[Task], string],
  @Match[request, {
    (Request/ListTasks[], (tasks, formatList[tasks])),
    (Request/Stats[], (tasks, statsText[tasks])),
    (Request/AddTask[title, priority], @Block[
      @Let[added, addTask[tasks, title, priority]],
      @Let[newTasks, @Fst[added]],
      @Let[id, @Snd[added]],
      @Match[save[path, newTasks], {
        (Result/Ok[_], (newTasks, f"added {id}")),
        (Result/Err[error], (newTasks, formatError[error]))
      }]
    ]),
    (Request/CompleteTask[id], @Block[
      @Let[newTasks, completeTask[tasks, id]],
      @Match[save[path, newTasks], {
        (Result/Ok[_], (newTasks, f"completed {id}")),
        (Result/Err[error], (newTasks, formatError[error]))
      }]
    ]),
    (Request/RemoveTask[id], @Block[
      @Let[newTasks, removeTask[tasks, id]],
      @Match[save[path, newTasks], {
        (Result/Ok[_], (newTasks, f"removed {id}")),
        (Result/Err[error], (newTasks, formatError[error]))
      }]
    ])
  }]];

@Let[service, @Handler[
  [self : Pid[Command, i64], tasks : List[Task], path : string] : i64,
  @Match[@Receive[0u, Option/None[]], {
    (/Some[message], @Match[message, {
      (Command/Call[request, reply], @Block[
        @Let[outcome, handle[request, tasks, path]],
        @Let[sent, @Send[reply, 0u, Reply/Text[@Snd[outcome]]]],
        @Continue[@Fst[outcome], path]
      ])
    }]),
    (/None[], 0)
  }]]];

@Def[loop, [service_pid : Pid[Command, i64]] : nil,
  @Block[
    @Match[ReadLine["> "], {
      (Result/Ok[lineOpt], @Match[lineOpt, {
        (Option/Some[line], @Block[
          @If[EqualString[line, "quit"],
            nil,
            @Block[
              @Match[parseRequest[line], {
                (Option/Some[request], @Block[
                  @Let[answer, ask[service_pid, request]],
                  Print[answer],
                  loop[service_pid]
                ]),
                (Option/None[], @Block[
                  Print["unknown command"],
                  loop[service_pid]
                ])
              }]
            ]]
        ]),
        (Option/None[], nil)
      }]),
      (Result/Err[error], Print[formatError[error]])
    }]
  ]];

@Match[load["tasks.txt"], {
  (Result/Ok[tasks], @Block[
    @Let[service_pid, @Spawn[1u, service, tasks, "tasks.txt"]],
    @Let[registered, @Register["task-service", service_pid]],
    @Let[ready, registered],
    Print[f"task service ready: registered={ready}"],
    Print["commands: list, stats, add <priority> <title>, done <id>, remove <id>, quit"],
    loop[service_pid],
    @Let[killed, @Kill[service_pid]],
    Print["bye"]
  ]),
  (Result/Err[error], Print[formatError[error]])
}]
