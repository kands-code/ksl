@Let[FLAG_WINDOW_MINIMIZED, 0x00000200u32];
@Let[FLAG_WINDOW_MAXIMIZED, 0x00000400u32];
@Let[FLAG_WINDOW_UNFOCUSED, 0x00000800u32];
@Let[FLAG_WINDOW_TOPMOST, 0x00001000u32];
@Let[FLAG_WINDOW_ALWAYS_RUN, 0x00000100u32];
@Let[FLAG_WINDOW_TRANSPARENT, 0x00000010u32];
@Let[FLAG_WINDOW_HIGHDPI, 0x00002000u32];
