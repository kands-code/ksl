# 颜色, 值与 raylib.h 的 LIGHTGRAY 等定义一致.
@Let[LIGHTGRAY, Rgba[200u8, 200u8, 200u8, 255u8]];
@Let[GRAY, Rgba[130u8, 130u8, 130u8, 255u8]];
@Let[DARKGRAY, Rgba[80u8, 80u8, 80u8, 255u8]];
@Let[YELLOW, Rgba[253u8, 249u8, 0u8, 255u8]];
