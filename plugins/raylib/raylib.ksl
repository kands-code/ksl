# 窗口标志, 用 BitOrU32 组合.
@Let[FLAG_VSYNC_HINT, 0x00000040u32];
@Let[FLAG_FULLSCREEN_MODE, 0x00000002u32];
@Let[FLAG_WINDOW_RESIZABLE, 0x00000004u32];
@Let[FLAG_WINDOW_UNDECORATED, 0x00000008u32];
