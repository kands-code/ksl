@Let[DARKBLUE, Rgba[0u8, 82u8, 172u8, 255u8]];
@Let[PURPLE, Rgba[200u8, 122u8, 255u8, 255u8]];
@Let[VIOLET, Rgba[135u8, 60u8, 190u8, 255u8]];
