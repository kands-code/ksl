# 延迟投递的开销.
#
# 主脚本向同一个服务 Actor 注册大量 @SetTimer, 覆盖共享定时堆的插入,
# 到期取出与消息投递. 服务 Actor 收齐全部延迟消息后返回.

@Let[server, @Handler[[self : Pid[i64, i64], remaining : i64] : i64,
  @If[EqualI64[remaining, 0], 0,
    @Match[@Receive[0u, Option/None[]], {
      (/Some[_], @Continue[SubI64[remaining, 1]]),
      (/None[], -1)
    }]
  ]
]];

@Def[arm, [n : i64, target : Pid[i64, i64]] : nil,
  @If[LessOrEqualI64[n, 0], nil,
    @Block[
      @Let[_timer, @SetTimer[target, 0u, 1, 1U]],
      arm[SubI64[n, 1], target]
    ]
  ]
];

@Let[service, @Spawn[1u, server, 20000]];
@Let[_armed, arm[20000, service]];
@Let[result, @Match[@Join[service], { (/Ok[v], v), (/Err[e], -1) }]];
@Let[printed, Print[f"{result}"]];
nil
