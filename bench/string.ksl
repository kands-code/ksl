# 字符串转换与比较的开销.
#
# 拼接一段长文本, 拆成字符列表再合回字符串, 最后比较内容.
# 覆盖字符串拼接, 拆分, 合并与比较四条路径.

# @result 1220000

@Let[source, "The quick brown fox jumps over the lazy dog, again and again."];
@Let[wide, StringJoin[@ListRepeat[source, 20000U]]];
@Let[chars, StringToChars[wide]];
@Let[joined, CharsToString[chars]];
@Let[_, EqualString[joined, wide]];
@Let[result, U64ToI64[@ListLength[chars]]];
Print[f"{result}\n"]
