# @value (0U, (true, ({1, 2, 3, 4, 3, 1, 2}, ({1, 3}, {1, 3, 4}))))
# Set 的基本操作, 集合代数, 过滤与空集.
@Let[empty_len, @Block[
  @Let[s : Set[i64], @Set[]],
  @SetLength[s]
]];
@Let[basic, @Block[
  @Let[s0, @Set[1, 2, 3]],
  @Let[s1, @SetInsert[s0, 4]],
  @Let[s2, @SetRemove[s1, 2]],
  And[@SetHas[s2, 4], And[@SetHas[s1, 2], EqualU64[@SetLength[s2], 3U]]]
]];
@Let[algebra, @Block[
  @Let[a, @Set[1, 2, 3]],
  @Let[b, @Set[3, 4]],
  @Let[union, @SetUnion[a, b]],
  @Let[intersect, @SetIntersect[a, b]],
  @Let[difference, @SetDifference[a, b]],
  @ListConcatenate[@ListConcatenate[@SetItems[union], @SetItems[intersect]], @SetItems[difference]]
]];
@Let[filtered, @Block[
  @Let[s, @Set[1, 2, 3, 4]],
  @Let[odd, @SetFilter[s, @Fn[[n : i64] : bool, EqualI64[ModuloI64[n, 2], 1]]]],
  @SetItems[odd]
]];
@Let[items, @Block[
  @Let[s0, @SetFromList[{1, 2, 3, 4}]],
  @Let[s1, @SetRemove[s0, 2]],
  @SetItems[s1]
]];
(empty_len, (basic, (algebra, (filtered, items))))
