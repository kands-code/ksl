@Def[i64ListEq, [xs : List[i64], ys : List[i64]] : bool,
  @Which[
    {(@IsListEmpty[xs], @IsListEmpty[ys]),
     (@IsListEmpty[ys], false)},
    And[
      EqualI64[@ListHead[xs], @ListHead[ys]],
      i64ListEq[@ListTail[xs], @ListTail[ys]]
    ]
  ]
];

@Let[empty : Set[i64], @Set[]];
@Assert[EqualU64[@SetLength[empty], 0U], "空集合长度"];
@Assert[@IsSetEmpty[empty], "空集合判定"];

@Let[s0, @Set[1, 2, 3]];
@Let[s1, @SetInsert[s0, 4]];
@Assert[Not[@IsSetEmpty[s1]], "非空集合判定"];
@Assert[EqualBool[@SetHas[s1, 4], true], "集合插入"];
@Assert[EqualBool[@SetHas[s1, 2], true], "插入不删除原有元素"];
@Let[s2, @SetRemove[s1, 2]];
@Assert[EqualBool[@SetHas[s2, 2], false], "集合删除"];
@Assert[EqualBool[@SetHas[s1, 2], true], "删除不改变原集合"];
@Assert[EqualU64[@SetLength[s2], 3U], "删除后长度"];

@Let[a, @Set[1, 2, 3]];
@Let[b, @Set[3, 4]];
@Assert[i64ListEq[@SetItems[@SetUnion[a, b]], {1, 2, 3, 4}], "集合并集"];
@Assert[i64ListEq[@SetItems[@SetIntersect[a, b]], {3}], "集合交集"];
@Assert[i64ListEq[@SetItems[@SetDifference[a, b]], {1, 2}], "集合差集"];

@Assert[
  i64ListEq[
    @SetItems[@SetFilter[s1, @Fn[[n : i64] : bool, EqualI64[ModuloI64[n, 2], 1]]]],
    {1, 3}
  ],
  "集合按奇偶过滤"
];
@Assert[i64ListEq[@SetItems[@SetFromList[{1, 2, 2, 3, 4}]], {1, 2, 3, 4}], "集合去重"];
@Assert[
  i64ListEq[@SetItems[@SetRemove[@SetFromList[{1, 2, 3, 4}], 2]], {1, 3, 4}],
  "集合去重并删除"
];
