# 监视通知的投递与自身监视.
# 监视通知投递给监视者的最后一个信箱, 该信箱必须是 Pair[u64, ExitReason].
@Main[[self : Pid[nil, nil]] : nil,
  @Block[
    # 目标在监视前已经终止, 通知立即投递.
    @Let[finished, @Handler[[self : Pid[i64, i64]] : i64, 7]],
    @Let[watching_finished, @Handler[
      [self : Pid[Pair[u64, ExitReason], i64], dead : Pid[i64, i64]] : i64,
      @Block[
        @Let[_, @Monitor[dead]],
        @Match[@Receive[0u, Option/None[]], {
          (/Some[notice], @Match[@Snd[notice], {
            (/Halted[], @Match[@Join[dead], { (/Ok[v], v), (/Err[_], -1) }]),
            (_, -2)
          }]),
          (/None[], -3)
        }]
      ]]],
    @Let[dead, @Spawn[finished]],
    @Let[_, @Join[dead]],
    @Let[s3, @Spawn[watching_finished, dead]],
    @Assert[
      EqualI64[@Match[@Join[s3], { (/Ok[v], v), (/Err[_], -4) }], 7],
      "监视已终止目标立即投递"
    ],

    @Let[narcissist, @Handler[[self : Pid[Pair[u64, ExitReason], bool]] : bool,
      @Match[@Monitor[self], { (/Some[_], false), (/None[], true) }]]],
    @Let[s4, @Spawn[narcissist]],
    @Assert[
      @Match[@Join[s4], { (/Ok[v], v), (/Err[_], false) }],
      "监视自身返回 None"
    ]
  ]]
