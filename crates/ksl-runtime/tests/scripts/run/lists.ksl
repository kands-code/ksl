# 列表: 构造, 访问, 高阶操作与配对.

@Def[i64ListEq, [xs : List[i64], ys : List[i64]] : bool,
  @Which[
    {(@IsListEmpty[xs], @IsListEmpty[ys]),
     (@IsListEmpty[ys], false)},
    And[
      EqualI64[@ListHead[xs], @ListHead[ys]],
      i64ListEq[@ListTail[xs], @ListTail[ys]]
    ]
  ]
];

@Let[l, {1, 2, 3, 4}];
@Assert[EqualI64[@ListGet[l, 1u64], 2], "按下标取值"];
@Assert[EqualI64[@OptionGet[@ListLookup[l, 1u64], 0], 2], "安全取下标命中"];
@Assert[@IsNone[@ListLookup[l, 99u64]], "安全取下标越界"];
@Assert[EqualU64[@ListLength[l], 4u64], "原列表长度"];
@Assert[i64ListEq[@ListUpdate[l, 0u64, 9], {9, 2, 3, 4}], "按下标更新"];
@Assert[i64ListEq[@ListAppend[@ListUpdate[l, 0u64, 9], 5], {9, 2, 3, 4, 5}], "列表追加"];
@Assert[i64ListEq[@ListTake[l, 2u64], {1, 2}], "取前若干元素"];
@Assert[i64ListEq[@ListTake[l, 99u64], l], "取超过长度返回整个列表"];
@Assert[i64ListEq[@ListDrop[l, 2u64], {3, 4}], "丢弃前若干元素"];
@Assert[EqualU64[@ListLength[@ListDrop[l, 99u64]], 0u64], "丢弃超过长度返回空列表"];

@Let[doubled, @ListMap[l, @Fn[[x : i64] : i64, MulI64[x, 2]]]];
@Assert[i64ListEq[doubled, {2, 4, 6, 8}], "列表映射"];
@Assert[
  i64ListEq[@ListFilter[doubled, @Fn[[x : i64] : bool, GreaterI64[x, 4]]], {6, 8}],
  "列表过滤"
];
@Assert[
  EqualI64[@ListFold[{6, 8}, @Fn[[x : i64, acc : i64] : i64, AddI64[x, acc]], 0], 14],
  "列表折叠"
];
@Assert[
  EqualBool[@ListAny[l, @Fn[[x : i64] : bool, GreaterI64[x, 2]]], true],
  "列表存在满足条件的元素"
];
@Assert[
  EqualBool[@ListAll[l, @Fn[[x : i64] : bool, GreaterI64[x, 0]]], true],
  "列表全部元素满足条件"
];

@Let[m, {1, 2, 3, 4, 5}];
@Assert[
  i64ListEq[@ListTakeWhile[m, @Fn[[x : i64] : bool, LessI64[x, 3]]], {1, 2}],
  "取满足条件的前缀"
];
@Assert[
  i64ListEq[@ListDropWhile[m, @Fn[[x : i64] : bool, LessI64[x, 3]]], {3, 4, 5}],
  "丢弃满足条件的前缀"
];
@Assert[i64ListEq[@ListReverse[m], {5, 4, 3, 2, 1}], "列表反转"];
@Assert[i64ListEq[@ListRepeat[7, 3u64], {7, 7, 7}], "列表重复"];
@Assert[i64ListEq[@ListFlatten[{{1, 2}, {3}}], {1, 2, 3}], "列表摊平"];
@Assert[
  i64ListEq[
    @ListMap[@ListChunk[m, 2u64], @Fn[[xs : List[i64]] : i64, U64ToI64[@ListLength[xs]]]],
    {2, 2, 1}
  ],
  "列表分组"
];
@Assert[
  i64ListEq[
    @ListZipWith[{1, 2, 3}, {10, 20}, @Fn[[a : i64, b : i64] : i64, AddI64[a, b]]],
    {11, 22}
  ],
  "拉链合并"
];
@Assert[
  EqualI64[@Fst[@ListGet[@ListZip[{1, 2}, {'a', 'b', 'c'}], 0u64]], 1],
  "拉链取首项"
];
@Assert[i64ListEq[@ListRiffle[{1, 2, 3}, 0, 1u64], {1, 0, 2, 0, 3}], "交错插入"];
@Assert[EqualU64[@ListLength[@ListWindow[l, 2u64]], 3u64], "滑窗后的长度"];
@Assert[
  i64ListEq[
    @ListMapIndexed[{10, 20, 30}, @Fn[[i : u64, x : i64] : i64, AddI64[U64ToI64[i], x]]],
    {10, 21, 32}
  ],
  "带下标映射"
];
@Assert[i64ListEq[@ListPrefixFold[{1, 2, 3}, AddI64, 0], {0, 1, 3, 6}], "前缀折叠"];

@Assert[
  EqualU64[
    @OptionGet[@ListFindIndex[m, @Fn[[x : i64] : bool, GreaterI64[x, 3]]], 99u64],
    3u64
  ],
  "查找首个满足条件的下标"
];
@Assert[
  @IsNone[@ListFindIndex[m, @Fn[[x : i64] : bool, GreaterI64[x, 9]]]],
  "查找未命中"
];
