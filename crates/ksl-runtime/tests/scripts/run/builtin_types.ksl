# 内置类型: Actor, Pid, Handler 与输入事件.
# 无断言的签名与绑定用于确认类型检查可通过.

@Def[pid_arg, [p : Pid[i64, string]] : nil, nil];
@Def[multi_mailbox, [p : Pid[i64, f64, string]] : nil, nil];
@Def[handler_state, [h : Handler[Pid[i64, string], i64]] : nil, nil];
@Def[exit_code, [e : ExitReason] : i64,
  @Match[e, {
    (/Halted[], 0),
    (/Killed[], 1),
    (/Failed[c, m], c)
  }]];
@Let[halted, ExitReason/Halted[]];
@Let[typed_handler, @Handler[[self : Pid[i64, string], n : i64] : string, "ok"]];
@Let[continuing, @Handler[[self : Pid[i64, string], n : i64] : string,
  @Continue[1]]];

@Let[key, KeyEvent/Char['a']];
@Let[input_error : InputError, InputError/Interrupted[]];
@Assert[
  @Match[key, { (KeyEvent/Char[_], true), (_, false) }],
  "内置按键类型"
];
@Assert[
  @Match[input_error, { (InputError/Interrupted[], true), (_, false) }],
  "内置输入错误类型"
];

# Handler 体内的数值后缀在运行时保持.
@Main[[self : Pid[nil, nil]] : nil,
  @Block[
    @Let[byte, @Handler[[self : Pid[i64, u8]] : u8,
      @Block[@Let[n : u8, 1u8], n]]],
    @Assert[
      EqualU8[@ResultGet[@Join[@Spawn[byte]], 0u8], 1u8],
      "Handler 体内的 u8 后缀保留"
    ]
  ]]
