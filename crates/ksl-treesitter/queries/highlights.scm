; 内置类型名.
;
; 原始类型与参数化类型构造器按名字识别; 其余类型名保持 @type.
;
; BEGIN primitive types
((type_name) @type.builtin
 (#any-of? @type.builtin
  "bool"
  "char"
  "f32"
  "f64"
  "i32"
  "i64"
  "nil"
  "string"
  "u32"
  "u64"
  "u8"
))
((identifier) @type.builtin
 (#any-of? @type.builtin
  "bool"
  "char"
  "f32"
  "f64"
  "i32"
  "i64"
  "nil"
  "string"
  "u32"
  "u64"
  "u8"
))
; END primitive types

; BEGIN type constructors
