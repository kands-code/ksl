; ksl 的彩虹括号查询.
;
; `@rainbow.scope` 捕获增加嵌套层级的节点, `@rainbow.bracket` 捕获括号本身.
; 括号与作用域节点必须在同一棵树中; 嵌套的调用, 容器与特殊形式各自换色.

["(" ")" "[" "]" "{" "}"] @rainbow.bracket

[
  (call)
  (list_literal)
  (pair)
  (let_form)
  (block_form)
  (if_form)
  (which_form)
  (which_arm)
  (fn_form)
  (def_form)
  (exit_form)
  (handler_form)
  (main_form)
  (continue_form)
  (spawn_form)
  (send_form)
  (receive_form)
  (join_form)
  (kill_form)
  (pid_serial_form)
  (set_timer_form)
  (cancel_timer_form)
  (halt_form)
  (sleep_form)
  (fix_form)
  (assert_form)
  (panic_form)
  (todo_form)
  (unreachable_form)
  (data_form)
  (data_variant)
  (export_form)
  (use_form)
  (link_form)
  (match_form)
  (match_arm)
  (qualified_pattern)
  (unqualified_pattern)
  (list_op_form)
  (pair_op_form)
  (dict_form)
  (set_form)
  (dict_op_form)
  (set_op_form)
  (option_op_form)
  (param_list)
  (generic_type)
  (fn_type)
] @rainbow.scope
