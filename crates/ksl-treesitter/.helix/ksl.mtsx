// require MT >= 2.26.9
//
// ksl 的 MT 管理器语法高亮.
//
// 特殊形式, 操作族, 内置函数与内置类型名单由 `scripts/gen-mtsx.sh` 生成,
// 不要手工修改 BEGIN/END 之间的内容. 原始字符串的终点复用起点捕获的
// 井号数量, 依赖 MT 2.26.9 的 export/var 功能.
{
    name: ["ksl", ".ksl"]
    comment: {startsWith: "#"}
    bracketPairs: ["{}", "[]", "()"]
    contains: [
        // 原始字符串: r"...", r#"..."#, r##"..."## 等.
        {
            start: {
                match: /r(#*)"/
                export: 1 => "rawHashes"
                0: "string"
            }
            end: {match: /"/ + var("rawHashes"), 0: "string"}
            style: "string"
        }

        // 格式化字符串: 整体按字符串处理, 插值内容单独着色.
        // 插值匹配器从 `{` 开始并消费到 `}`, 避免其中的引号提前结束字符串.
        {
            start: {match: /f"/}
            end: {match: /"/}
            style: "string"
            contains: [
                {match: /\\u\{[0-9A-Fa-f]+\}/, 0: "strEscape"}
                {match: /\\./, 0: "strEscape"}
                {match: /\{\{|\}\}/, 0: "strEscape"}
                {match: /\{([^{}]*)\}/, 1: "variable"}
            ]
        }

        // 普通字符串与字符字面量.
        {
            start: {match: /"/}
            end: {match: /"/}
            style: "string"
            contains: [
                {match: /\\u\{[0-9A-Fa-f]+\}/, 0: "strEscape"}
                {match: /\\./, 0: "strEscape"}
            ]
        }
        {
            start: {match: /'/}
            end: {match: /'/}
            style: "string"
            contains: [
                {match: /\\u\{[0-9A-Fa-f]+\}/, 0: "strEscape"}
                {match: /\\./, 0: "strEscape"}
            ]
        }

        // 数字: 二进制, 十进制, 十六进制, 浮点与指数; u8/u64 后缀共用同一风格.
        {
            number: "2|10|16|F|E"
            iSuffixes: "u"
            style: "number"
        }

        // 声明名: @Data 的类型名与 @Def 的函数名.
        {match: /(@)\s*(Data)\s*(\[\s*)([\p{L}_][\p{L}\p{N}_]*)/, 1: "operator", 2: "keyword", 4: "type"}
        {match: /(@)\s*(Def)\s*(\[\s*)([\p{L}_][\p{L}\p{N}_]*)/, 1: "operator", 2: "keyword", 4: "label"}

        // 字面量关键字.
        {match: keywordsToRegex("true false nil"), 0: "constant"}

        // 特殊形式.
        {match: keywordsToRegex(
            // BEGIN special forms
            "Assert Block CancelTimer Continue Data Def Dict Exit"
            "Export Fix Fn Halt Handler If Join Kill"
            "Let Match Monitor Panic PidSerial Receive Send Set"
            "SetTimer Sleep Spawn SpawnDetached Todo Unmonitor Unreachable Use"
            // END special forms
        ), 0: "keyword"}

        // 列表, 字典, 集合, Option 与 Result 操作族.
        {match: keywordsToRegex(
            // BEGIN operations
            "DictEntries DictFilter DictFromEntries DictGet DictHas DictKeys DictLength DictLookup"
            "DictMerge DictPut DictRemove DictUpdate DictValues Fst IsErr IsNone"
            "IsOk IsSome ListAll ListAny ListAppend ListChunk ListConcatenate ListDrop"
            "ListDropWhile ListFilter ListFlatten ListFold ListGet ListHead ListLength ListMap"
            "ListMapIndexed ListPrefixFold ListPrepend ListRepeat ListReverse ListRiffle ListTail ListTake"
            "ListTakeWhile ListUpdate ListWindow ListZip ListZipWith OptionAndThen OptionGet OptionMap"
            "Register ResultAndThen ResultGet ResultMap SetDifference SetFilter SetFromList SetHas"
            "SetInsert SetIntersect SetItems SetLength SetRemove SetUnion Snd Unregister"
            "WhereIs"
            // END operations
        ), 0: "keyword2"}

        // 内置函数.
        {match: keywordsToRegex(
            // BEGIN builtins
            "AbsF64 AbsI64 AddDay AddF64 AddHour AddI64 AddMillisecond AddMinute"
            "AddMonth AddSecond AddU64 AddU8 AddWeek AddYear And AppendFile"
            "AppendFileBytes ArcCos ArcCosh ArcSin ArcSinh ArcTan ArcTan2 ArcTanh"
            "Args BitAndI64 BitAndU64 BitAndU8 BitOrI64 BitOrU64 BitOrU8 BitReverseI64"
            "BitReverseU64 BitReverseU8 BitXorI64 BitXorU64 BitXorU8 Ceiling CharToI64 CharsToString"
            "Close ClosedFile CopyFile Cos Cosh CreateDirectory CreateDirectoryAll DateTimeToEpochMillis"
            "DecodeUtf8 DivideF64 DivideI64 DivideU64 DivideU8 EncodeUtf8 EpochMillisToDateTime EqualBool"
            "EqualChar EqualDateTime EqualF64 EqualI64 EqualString EqualU64 EqualU8 Floor"
            "Flush GetCurrentDirectory GetEnv GreaterF64 GreaterI64 GreaterOrEqualF64 GreaterOrEqualI64 GreaterOrEqualU64"
            "GreaterOrEqualU8 GreaterU64 GreaterU8 I64ToChar I64ToF64 I64ToU64 I64ToU8 IsDirectory"
            "IsFile IsPathExists JoinPath LessDateTime LessF64 LessI64 LessOrEqualF64 LessOrEqualI64"
            "LessOrEqualU64 LessOrEqualU8 LessU64 LessU8 ListDirectory ModuloI64 ModuloU64 ModuloU8"
            "MulF64 MulI64 MulU64 MulU8 Not Now NowUtc OpenAppend"
            "OpenRead OpenWrite Or ParseDateTime ParseF64 ParseI64 ParseU64 Power"
            "Print PrintError PrintRaw QuotientI64 ReadChunk ReadFile ReadFileBytes ReadKey"
            "ReadLine ReadLineFrom RemainderI64 RemoveDirectory RemoveFile RenamePath Round ShiftLeftI64"
            "ShiftLeftU64 ShiftLeftU8 ShiftRightI64 ShiftRightU64 ShiftRightU8 Sin Sinh Sqrt"
            "StringContains StringEndsWith StringJoin StringLength StringLines StringLowercase StringSplit StringStartsWith"
            "StringToChars StringTrim StringTrimEnd StringTrimStart StringUppercase StringWords SubDay SubF64"
            "SubHour SubI64 SubMillisecond SubMinute SubMonth SubSecond SubU64 SubU8"
            "SubWeek SubYear Tan Tanh TimeDay TimeFromParts TimeHour TimeInZone"
            "TimeMillisecond TimeMinute TimeMonth TimeSecond TimeToString TimeWeekday TimeYear TimeZoneName"
            "TimeZoneOffsetMinutes Truncate U64ToF64 U64ToI64 U64ToU8 U8ToI64 U8ToU64 WriteBytes"
            "WriteFile WriteFileBytes WriteString"
            // END builtins
        ), 0: "label"}

        // 内置类型.
        {match: keywordsToRegex(
            // BEGIN types
            "DateTime Dict ExitReason File Handler IOError KeyEvent List"
            "Option Pair Pid Result Set TimeError bool char"
            "f64 i64 string u64 u8"
            // END types
        ), 0: "type"
        }

        // 类型按上下文识别, 不按首字母大写猜测: 变量名可以是 A, 类型也可能小写.
        {match: /(:)\s*([\p{L}_][\p{L}\p{N}_]*)/, 1: "operator", 2: "type"}
        {match: /(\^)\s*\(\s*([\p{L}_][\p{L}\p{N}_]*)\s*,\s*([\p{L}_][\p{L}\p{N}_]*)\s*\)/, 1: "operator", 2: "type", 3: "type"}
        {match: /(\^)\s*([\p{L}_][\p{L}\p{N}_]*)/, 1: "operator", 2: "type"}
        {match: /([\p{L}_][\p{L}\p{N}_]*)(?=\s*\/)/, 1: "type"}

        // 调用名: 标识符后紧跟 `[`, 排除已经匹配的特殊形式, 操作与内置函数.
        {match: /([\p{L}_][\p{L}\p{N}_]*)(?=\s*\[)/, 1: "label"}

        // 抛弃记号 `_`.
        {match: /\b_+\b/, 0: "comment"}

        // `@` 是特殊形式前缀, `^` 是类型提升前缀, `/` 是受限名分隔符.
        {match: /[@^\/+\-]/, 0: "operator"}
        {match: /[,;:]/, 0: "operator"}

        // 变量兜底.
        {match: /[\p{L}_][\p{L}\p{N}_]*/, 0: "variable"}
    ]
}
